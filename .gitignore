# secrets / env
.env
.env.local
.env.*.local

# Claude Code config — kept fully local except the paper-trading safety hook
CLAUDE.md
.claude/*
!.claude/settings.json

# Personal notes — never commit even if this file ends up in the project folder by accident
PERSONAL-NOTES*.md

# node
node_modules/
.next/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ML tracking. The Analyst's MLflow history IS committed, by design (PRD 6a:
# "MLflow in local mode — commits into the repo"): the tracking DB at
# worker/mlflow/mlflow.db and run artifacts under worker/mlflow/artifacts/.
# Only ignore MLflow's scratch output: default stores created when MLflow is
# run WITHOUT our tracking URI (./mlruns, ./mlartifacts) and sqlite's
# transient journal/WAL files.
mlruns/
mlartifacts/
worker/mlflow/*.db-journal
worker/mlflow/*.db-wal
worker/mlflow/*.db-shm

# OS
.DS_Store
